#!/usr/bin/env node

import http from 'node:http';
import { exec, spawn } from 'node:child_process';
import util from 'node:util';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const execPromise = util.promisify(exec);
const __dirname = path.dirname(fileURLToPath(import.meta.url));
const PORT = 18890;

async function request(path, method = 'GET') {
  return new Promise((resolve, reject) => {
    const req = http.request({
      hostname: '127.0.0.1',
      port: PORT,
      path,
      method
    }, res => {
      let data = '';
      res.on('data', chunk => data += chunk);
      res.on('end', () => {
        try {
          resolve(JSON.parse(data));
        } catch (e) {
          resolve(data);
        }
      });
    });

    req.on('error', err => reject(err));
    req.end();
  });
}

const args = process.argv.slice(2);
const command = args[0] || 'status';

async function main() {
  if (command === 'status') {
    try {
      const data = await request('/api/status');
      console.log('\n================== OPENCLAW SYSTEM GOVERNOR ==================');
      console.log(`Status: ACTIVE | Dashboard: http://127.0.0.1:${PORT}`);
      console.log(`Memory: ${data.memory.usedGB}GB / ${data.memory.totalGB}GB (${data.memory.memPressurePercent}% pressure)`);
      console.log(`CPU Load: ${data.memory.loadAvg.map(n => n.toFixed(2)).join(', ')}`);
      console.log('--------------------------------------------------------------');
      console.log('PID\tRSS(MB)\tCPU(%)\tSTATE\tCATEGORY\tNAME');
      console.log('--------------------------------------------------------------');
      data.processes.forEach(p => {
        const stateStr = p.isPaused ? 'PAUSED' : 'RUNNING';
        console.log(`${p.pid}\t${p.rssMB}\t${p.cpu.toFixed(1)}\t${stateStr}\t${p.category}\t${p.friendlyName}`);
      });
      console.log('==============================================================\n');
    } catch (err) {
      console.log(`[SysGov] Daemon is not currently running. Start with: sysgov start`);
    }
  } else if (command === 'optimize') {
    try {
      console.log('[SysGov] Triggering optimization pass...');
      const res = await request('/api/optimize', 'POST');
      console.log(`[SysGov] ${res.summary}`);
    } catch (err) {
      console.error(`[SysGov] Error contacting daemon: ${err.message}`);
    }
  } else if (command === 'start') {
    const serverPath = path.join(__dirname, '../src/server.js');
    const child = spawn(process.execPath, [serverPath], {
      detached: true,
      stdio: 'ignore'
    });
    child.unref();
    console.log(`[SysGov] Started daemon (PID: ${child.pid}). Dashboard at http://127.0.0.1:${PORT}`);
  } else if (command === 'stop') {
    try {
      const { stdout } = await execPromise(`pgrep -f "openclaw/sysgov/src/server.js"`);
      const pids = stdout.trim().split('\n').filter(Boolean);
      for (const pid of pids) {
        process.kill(parseInt(pid, 10), 'SIGTERM');
      }
      console.log('[SysGov] Stopped daemon.');
    } catch (e) {
      console.log('[SysGov] No running daemon found.');
    }
  } else {
    console.log(`Usage: sysgov [status | optimize | start | stop]`);
  }
}

main();
